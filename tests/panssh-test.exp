#!/usr/bin/expect -f
# panssh-test.exp
# Simple PanSSH interactive test harness

# -------------------------------
# Helper procedures
# -------------------------------

# Remove ANSI escape sequences from text
proc strip_ansi {text} {
    regsub -all {\x1B\[[0-9;]*[A-Za-z]} $text "" text
    return $text
}

proc await {expected {limit 5}} {
    expect -timeout $limit $expected {
        puts "✅ Found $limit: `$expected`"
    } timeout {
        puts "❌ Timed out awaiting: `$expected`"
        exit 1
    }       
}

# Send a command and wait for the next prompt
proc send_cmd {cmd expected {prompt $prompt} {limit 5}} {
    send "$cmd\r"
    await $expected $limit
    await $prompt $limit
}

proc check_local_file {file content} {
    # Read file, then delete it.
    set file_content [exec cat $file]
    exec rm $file

    # Confirm expected file content
    if {$file_content ne $content} {
        puts "❌ Unexpected content in $file"
        exit 1
    }
}

# -------------------------------
# Start PanSSH session
# -------------------------------

set site "ngd11"
set environment "dev"
set host "$site.$environment"

# Find directory of this script
set editor "editor-test.sh"
set script_dir [file dirname [info script]]
set env(EDITOR) [file join $script_dir "$editor"]

set cwd "/code"
set prompt "$host:$cwd\$ "

set timeout 5
spawn ./panssh $host

# Debug: log all output to stdout
log_user 1

# Wait for welcome message
expect "PanSSH 1.3.2: Connected to $host" {
    puts "✅ Welcome message"
}

# --- Initial prompt ---
await "$prompt"

# --- Initial directory ---
send_cmd "pwd" "/code" "$prompt"

# --- cd /tmp ---
set cwd "/tmp"
set prompt "$host:$cwd\$ "
send_cmd "cd $cwd && pwd" "/tmp" "$prompt"

# --- create file ---
set test_file "panssh-test.txt"
set content "Created by automated PanSSH test"
send_cmd "echo $content | tee $test_file" "$content" "$prompt"
send_cmd "cat $test_file" "$content" "$prompt"

# --- view file ---
send_cmd ".view $test_file" "editor exit" "$prompt"
send_cmd "cat $test_file" "$content" "$prompt"

# --- edit file ---
set content "Edited by automated PanSSH test"
send_cmd ".edit $test_file" "editor exit" "$prompt"
send_cmd "cat $test_file" "$content" "$prompt"

# --- edit file (unchanged) ---
send_cmd ".edit $test_file" "🟡 File has not changed." "$prompt"
send_cmd "cat $test_file" "$content" "$prompt"

# --- edit new file ---
send_cmd "rm $test_file" "$prompt" "$prompt"
send_cmd ".edit $test_file" "editor exit" "$prompt"
send_cmd "cat $test_file" "$content" "$prompt"

# --- copy to local ---
set test_file_local "/tmp/$test_file"
exec rm -f $test_file_local

send_cmd ".copy $test_file local:$test_file_local" "$prompt" "$prompt"
check_local_file "$test_file_local" "$content"

send_cmd ".copyr $test_file local:$test_file_local" "$prompt" "$prompt"
check_local_file "$test_file_local" "$content"

send_cmd ".rsync -t $test_file local:$test_file_local" "$prompt" "$prompt"
check_local_file "$test_file_local" "$content"

# --- .help and misc commands ---
send_cmd ".help" "Short versions:*" "$prompt"
send_cmd ".ls" "✅ auto-ls enabled" "$prompt"
send_cmd ".ls" "🚫 auto-ls disabled" "$prompt"

# -------------------------------
# Exit
# -------------------------------

puts "\nExiting..."

sleep 1
send_cmd "exit" "Connection to $host closed." "1"
puts "PanSSH interactive test complete."
